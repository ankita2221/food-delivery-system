{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with roles and personal information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the user"
        },
        "name": {
          "type": "string",
          "description": "User full name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["customer", "restaurant", "delivery", "admin"],
          "description": "Platform access role"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "address": {
          "type": "string",
          "description": "Delivery or business address"
        },
        "restaurantId": {
          "type": "string",
          "description": "For restaurant roles, links to their restaurant document"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the user account was created"
        }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Restaurant details and meta information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cuisine": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "reviewsCount": {
          "type": "number"
        },
        "image": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean"
        },
        "deliveryTime": {
          "type": "string"
        },
        "deliveryFee": {
          "type": "number"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "name", "cuisine", "ownerId", "isActive"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Dishes and snacks offered by restaurants",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "restaurantId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": ["id", "restaurantId", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "An online food delivery order",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "customerPhone": {
          "type": "string"
        },
        "restaurantId": {
          "type": "string"
        },
        "restaurantName": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "totalAmount": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "deliveryAddress": {
          "type": "string"
        },
        "deliveryFee": {
          "type": "number"
        },
        "paymentStatus": {
          "type": "string"
        },
        "paymentMethod": {
          "type": "string"
        },
        "deliveryPartnerId": {
          "type": "string"
        },
        "deliveryPartnerName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["id", "customerId", "restaurantId", "items", "totalAmount", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback left on restaurants",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "restaurantId": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "restaurantId", "customerId", "rating"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Platform alerts pushed to users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "userRole": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "read": {
          "type": "boolean"
        },
        "orderId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "userId", "title", "message", "read"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users of the platform"
    },
    "restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Registered restaurants"
    },
    "menuItems/{menuItemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Dishes belonging to restaurants"
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Platform delivery orders"
    },
    "reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews for restaurants"
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Pushed notifications"
    }
  }
}
